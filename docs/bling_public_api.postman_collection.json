            ],
            "url": {
              "raw": "{{publicBaseUrl}}/auth/sign-out",
              "host": [
                "{{publicBaseUrl}}"
              ],
              "path": [
                "auth",
                "sign-out"
              ],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{client_refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{client_access_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.unset('client_access_token');",
                  "pm.collectionVariables.unset('client_refresh_token');",
                  "pm.globals.unset('client_access_token');",
                  "pm.globals.unset('client_refresh_token');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
